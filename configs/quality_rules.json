{
  "version": "demo-policy-v2",
  "description": "教学示范策略：固定拍摄位置的瓶类顶视图；输入门控与通过面积门槛由正常校准图校准，关键区/拒收门槛仍需工厂专家验证。",
  "critical_roi": [
    0.2,
    0.2,
    0.8,
    0.8
  ],
  "review_margin": 0.1,
  "min_anomaly_area": 0.005,
  "pass_area_ratio": 0.005,
  "pass_critical_area_ratio": 0.005,
  "reject_area": 0.06,
  "critical_overlap": 0.2,
  "min_brightness": 15,
  "max_brightness": 245,
  "min_sharpness": 3.0,
  "input_gate": {
    "enabled": true,
    "max_aspect_deviation": 0.15,
    "resolution_tolerance": 0.25
  },
  "calibration": {
    "bottle": "calibration/bottle.json",
    "synthetic": "calibration/synthetic.json"
  }
}
